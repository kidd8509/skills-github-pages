# ─── WeCom App (企业应用) Settings ─────────────────────────────────────────────
# From WeCom admin console → My Apps → <Your App>
WECOM_CORP_ID=ww_your_corp_id
WECOM_AGENT_ID=1000001
WECOM_APP_SECRET=your_app_secret

# WeCom App callback settings (Receiving Message → Settings)
# Token and EncodingAESKey are generated when you configure the callback URL
WECOM_TOKEN=your_callback_token
WECOM_ENCODING_AES_KEY=your_43_char_aes_key

# ─── WeCom Group Robot Webhook ──────────────────────────────────────────────────
# From a WeCom group → "..." → Add Group Robot → copy Webhook URL
WECOM_GROUP_ROBOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3000

# ─── Copilot CLI ────────────────────────────────────────────────────────────────
# Path to the copilot binary (leave blank to auto-detect from PATH)
COPILOT_BIN=
# Timeout in milliseconds for a single Copilot CLI call (default 60000)
COPILOT_TIMEOUT_MS=60000
# System prompt prepended before every user message
COPILOT_SYSTEM_PROMPT=You are a helpful assistant. Reply concisely in the same language as the user.
# Maximum output length characters to forward to WeCom (longer replies are truncated)
COPILOT_MAX_LENGTH=2000

# ─── Optional WebSocket inbound client ──────────────────────────────────────────
# Set to "true" to enable the unofficial WeCom plugin WebSocket inbound client
ENABLE_WS_CLIENT=false
# WebSocket URL provided by your local WeCom plugin
WS_URL=ws://127.0.0.1:8888/ws
# Optional auth token sent as first message after connect
WS_AUTH_TOKEN=
# Milliseconds between reconnect attempts (default 5000)
WS_RECONNECT_DELAY_MS=5000

# ─── Rate limiting ───────────────────────────────────────────────────────────────
# Maximum requests per IP per window before returning 429 (default 60)
WEBHOOK_RATE_LIMIT_MAX=60
# Window size in milliseconds (default 60000 = 1 minute)
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# ─── File Exchange ───────────────────────────────────────────────────────────────
# Local directory where downloaded WeCom attachments are stored
INBOX_DIR=./inbox
# Local directory for files you want to send back to WeCom
OUTBOX_DIR=./outbox
